    "successValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "readback"
          ],
          "properties": {
            "kind": {
              "const": "READBACK_INSPECTION"
            },
            "target": {
              "$ref": "#/$defs/readback_target"
            },
            "readback": {
              "$ref": "#/$defs/readback"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "target": {
                    "const": "NAMESPACE"
                  }
                }
              },
              "then": {
                "properties": {
                  "readback": {
                    "properties": {
                      "kind": {
                        "const": "NAMESPACE"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "target": {
                    "const": "RUN"
                  }
                }
              },
              "then": {
                "properties": {
                  "readback": {
                    "properties": {
                      "kind": {
                        "const": "RUN"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "target": {
                    "const": "RECEIPT_CHAIN"
                  }
                }
