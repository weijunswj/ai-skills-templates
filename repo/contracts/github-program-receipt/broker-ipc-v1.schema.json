{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.broker-ipc.v1",
  "title": "Toolkit broker IPC - Lock-007 inherited typed contract",
  "$comment": "Authority: Run-030 sections 11-15; Child 5544075873, 5551641263, 5552422741, 5557964784, 5558994119. Structural schema; digests, request binding and readback integrity also require the protocol validator. Payload max 65536 UTF-8 bytes, nesting 16, object keys 64, array items 256, strings 4096 UTF-8 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "operation",
    "namespace",
    "lock",
    "expected"
  ],
  "properties": {
