    },
    "source_revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_digest", "child", "complete", "parent"],
      "properties": {
        "canonical_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body_digest", "prefix_digest", "revision", "suffix_digest"],
          "properties": {
            "body_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "prefix_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "revision": { "type": "string", "pattern": "^(?!OPEN$|CLOSED$)[^\\r\\n]{1,256}$" },
            "suffix_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "child": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body_digest", "prefix_digest", "revision", "suffix_digest"],
          "properties": {
            "body_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "prefix_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "revision": { "type": "string", "pattern": "^(?!OPEN$|CLOSED$)[^\\r\\n]{1,256}$" },
            "suffix_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "complete": { "const": true }
      }
    },
    "write_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "body_digest", "complete", "lock", "reference", "repository", "root", "scope"],
      "properties": {
        "reference": { "type": "string" },
        "body": { "type": "string" },
        "body_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "repository": { "const": "weijunswj/ai-agent-toolkit" },
        "root": { "const": "E3-V5-POST-MERGE-EPOCH-FINALISATION-001" },
        "lock": { "const": "DL-S2-E3-V5-POST-MERGE-EPOCH-FINALISATION-001" },
        "scope": { "const": "POST_MERGE_EPOCH_FINALISATION" },
        "complete": { "const": true }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collections", "complete"],
      "properties": {
        "complete": { "const": true },
        "collections": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["complete", "endpoint_or_query_identity", "expected_count", "id", "inventory_digest", "page_count", "retrieved_count"],
            "properties": {
              "id": { "type": "string" },
              "endpoint_or_query_identity": { "type": "string" },
              "page_count": { "const": 1 },
              "retrieved_count": { "type": "integer", "minimum": 1 },
              "expected_count": { "type": "integer", "minimum": 1 },
              "inventory_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "complete": { "const": true }
            }
          }
        }
      }
    },
    "provider_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "facts_digest", "inventory", "provider_cas_claim", "provider_client_used"],
      "properties": {
        "inventory": { "const": "EXACT_BOUNDED" },
        "provider_client_used": { "const": false },
        "provider_cas_claim": { "const": false },
        "facts_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "complete": { "const": true }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticated", "identity", "kind", "provider_client_used", "version"],
      "properties": {
        "kind": { "const": "WEB_AUTHENTICATED_GITHUB_COLLECTION" },
        "identity": { "const": "github-web-readonly-adapter" },
        "version": { "const": "v1" },
        "authenticated": { "const": true },
        "provider_client_used": { "const": false }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acknowledgement", "acknowledgement_loss_operation_order", "checkpoint", "complete", "completed_operation_orders", "continuation", "duplicate_event_count", "previous_source_binding", "readback"],
      "properties": {
        "checkpoint": { "type": "string" },
        "acknowledgement": { "enum": ["CONFIRMED", "LOST"] },
        "acknowledgement_loss_operation_order": { "type": ["integer", "null"], "minimum": 1 },
        "completed_operation_orders": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "continuation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["authority_body_digest", "complete", "decision_digest", "exact_readback", "fresh_complete_rebind", "previous_checkpoint"],
          "properties": {
            "previous_checkpoint": { "type": "string" },
            "decision_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "authority_body_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "fresh_complete_rebind": { "const": true },
            "exact_readback": { "const": true },
            "complete": { "const": true }
          }
        },
        "readback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "exact"],
          "properties": { "complete": { "const": true }, "exact": { "const": true } }
        },
        "previous_source_binding": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/properties/source_binding" }
          ]
        },
        "duplicate_event_count": { "const": 1 },
        "complete": { "const": true }
      }
    },
    "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
