      "properties": { "schema": { "const": "toolkit.github-program.state.v5" }, "design_lock": { "const": "DL-S2-GITHUB-PROGRAM-SURFACE-RECOVERY-003" }, "repository": { "$ref": "#/$defs/safeLine" }, "parent": { "type": "object", "additionalProperties": false, "required": ["issue", "title", "goal"], "properties": { "issue": { "$ref": "#/$defs/issue" }, "title": { "$ref": "#/$defs/safeLine" }, "goal": { "$ref": "#/$defs/safeText" } } }, "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/child" } }, "prs": { "type": "array", "items": { "$ref": "#/$defs/pr" } }, "concurrency_authority": { "$ref": "#/$defs/concurrencyAuthority" }, "active_lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } }, "predecessor_contract_digest": { "$ref": "#/$defs/digest" }, "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "historical_transitions": { "type": "array", "items": { "$ref": "#/$defs/historicalTransition" } }, "extensions": { "type": "array", "items": { "$ref": "#/$defs/extension" } } }
