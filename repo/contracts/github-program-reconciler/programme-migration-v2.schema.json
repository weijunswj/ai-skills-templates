{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.migration.v2",
  "title": "GitHub programme v4 to v5 migration preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "preview_kind",
    "repository",
    "parent_issue",
    "authority_ref",
    "authority_digest",
    "source_state_schema",
    "target_state_schema",
    "expected_revision",
    "source_snapshot_digest",
    "source_event_inventory_digest",
    "source_canonical_digest",
    "source_body_digests",
    "target_canonical_digest",
    "target_managed_body_digests",
    "target_body_digests",
    "candidate_binding_digest",
    "trusted_pr_inspection_digest",
    "trusted_relationship_inspection_digest",
    "relationship_capability_digest",
    "required_relationship_operations",
    "bootstrap",
    "bootstrap_conformance",
    "labels",
    "native_relationships",
    "managed_event_delta",
    "required_receipt_delta",
    "receipt_consumption_plan",
    "operations",
    "operation_binding_digest",
    "operations_digest",
    "ordered_operation_ids",
    "expected_snapshot_digest",
    "expected_snapshot",
    "mutation_authority",
    "finality_authority",
    "preview_only",
    "preview_id"
  ],
  "properties": {
    "ok": { "const": true },
    "code": { "const": "PROGRAMME_V5_MIGRATION_PREVIEW_READY" },
    "schema": { "const": "toolkit.github-program.migration.v2" },
    "preview_kind": { "const": "MIGRATION" },
    "repository": { "$ref": "#/$defs/safeLine" },
    "parent_issue": { "$ref": "#/$defs/issue" },
    "source_state_schema": { "const": "toolkit.github-program.state.v4" },
    "target_state_schema": { "const": "toolkit.github-program.state.v5" },
    "authority_digest": { "$ref": "#/$defs/digest" },
    "source_snapshot_digest": { "$ref": "#/$defs/digest" },
    "source_event_inventory_digest": { "$ref": "#/$defs/digest" },
    "authority_ref": { "$ref": "#/$defs/safeLine" },
    "expected_revision": { "$ref": "#/$defs/safeLine" },
    "source_canonical_digest": { "$ref": "#/$defs/digest" },
    "source_body_digests": { "$ref": "#/$defs/bodyDigests" },
    "target_canonical_digest": { "$ref": "#/$defs/digest" },
    "target_managed_body_digests": { "$ref": "#/$defs/bodyDigests" },
    "target_body_digests": { "$ref": "#/$defs/bodyDigests" },
    "candidate_binding_digest": { "$ref": "#/$defs/nullOrDigest" },
    "trusted_pr_inspection_digest": { "$ref": "#/$defs/digest" },
    "trusted_relationship_inspection_digest": { "$ref": "#/$defs/digest" },
    "relationship_capability_digest": { "$ref": "#/$defs/digest" },
    "required_relationship_operations": { "$ref": "#/$defs/relationshipOperations" },
    "bootstrap": { "$ref": "#/$defs/bootstrapReport" },
    "bootstrap_conformance": { "$ref": "#/$defs/bootstrapConformance" },
    "labels": { "$ref": "#/$defs/labels" },
    "native_relationships": { "$ref": "#/$defs/nativeRelationships" },
    "managed_event_delta": { "$ref": "#/$defs/migrationEventDelta" },
    "required_receipt_delta": { "$ref": "#/$defs/requiredReceiptDelta" },
    "receipt_consumption_plan": { "$ref": "#/$defs/receiptConsumptionPlan" },
    "operations": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/operation" } },
    "operations_digest": { "$ref": "#/$defs/digest" },
    "ordered_operation_ids": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "uniqueItems": true },
    "expected_snapshot_digest": { "$ref": "#/$defs/digest" },
    "expected_snapshot": { "$ref": "#/$defs/expectedSnapshot" },
    "mutation_authority": { "const": "NOT_GRANTED" },
    "finality_authority": { "const": "NOT_GRANTED" },
    "preview_only": { "const": true },
    "preview_id": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "issue": { "type": "integer", "minimum": 1 },
    "safeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "safeLine": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$" },
    "safeText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullOrDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "textArray": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/safeText" } },
    "bodyDigests": {
      "type": "object",
      "required": ["parent", "children", "prs"],
      "additionalProperties": false,
      "properties": {
        "parent": { "$ref": "#/$defs/digest" },
        "children": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
        "prs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/safeLine" } }
    },
    "relationshipOperations": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "controllerBootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "profile", "repository", "parent_issue", "programme_state_schema", "surface_contract_schema", "toolkit_package_version", "toolkit_contract", "conformance", "compatibility"],
      "properties": {
        "$schema": { "type": "string" },
        "schema": { "const": "toolkit.github-program.controller-bootstrap.v1" },
        "profile": { "const": "github-managed-programme" },
        "repository": { "$ref": "#/$defs/safeLine" },
        "parent_issue": { "$ref": "#/$defs/issue" },
        "programme_state_schema": { "const": "toolkit.github-program.state.v5" },
        "surface_contract_schema": { "$ref": "#/$defs/safeLine" },
        "toolkit_package_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "toolkit_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["repository", "revision", "path", "sha256"],
          "properties": {
            "repository": { "$ref": "#/$defs/safeLine" }, "revision": { "$ref": "#/$defs/sha" },
            "path": { "type": "string", "pattern": "^(?:repo|\\.github)/[A-Za-z0-9._/-]+$" }, "sha256": { "$ref": "#/$defs/digest" }
          }
        },
        "conformance": {
          "type": "object", "additionalProperties": false, "required": ["required_class", "migration_from"],
          "properties": { "required_class": { "const": "CURRENT_MANAGED" }, "migration_from": { "type": "array", "minItems": 1, "items": { "const": "toolkit.github-program.state.v4" } } }
        },
        "compatibility": {
          "type": "object", "additionalProperties": false, "required": ["fail_closed_on_unknown_major"],
          "properties": { "fail_closed_on_unknown_major": { "const": true } }
        }
      }
    },
    "nativeAssociation": {
      "type": "object", "additionalProperties": false, "required": ["parent_issue", "child_issue", "kind"],
      "properties": { "parent_issue": { "$ref": "#/$defs/issue" }, "child_issue": { "$ref": "#/$defs/issue" }, "kind": { "enum": ["CLOSING", "CROSS_REFERENCE"] } }
    },
    "nativeSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["children", "dependencies", "associated_prs", "pr_associations", "api_version"],
      "properties": {
        "children": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "dependencies": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/issue" } } },
        "associated_prs": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "pr_associations": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nativeAssociation" } },
        "api_version": { "$ref": "#/$defs/safeLine" }
      }
    },
    "nativeRelationships": {
      "type": "object", "additionalProperties": false,
      "required": ["before", "after", "changed", "pr_associations"],
      "properties": {
        "before": { "$ref": "#/$defs/nativeSnapshot" }, "after": { "$ref": "#/$defs/nativeSnapshot" },
        "changed": { "type": "boolean" },
        "pr_associations": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nativeAssociation" } }
      }
    },
    "bootstrapConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "repository", "parent_issue", "apply_operation", "ownership"],
      "properties": {
        "valid": { "const": true },
        "repository": { "$ref": "#/$defs/safeLine" },
        "parent_issue": { "$ref": "#/$defs/issue" },
        "apply_operation": { "const": false },
        "ownership": { "const": "repository-code-via-PR" }
      }
    },
    "bootstrapReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "candidate", "after", "candidate_digest", "conformance"],
      "properties": {
        "before": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/controllerBootstrap" }] },
        "candidate": { "$ref": "#/$defs/controllerBootstrap" },
        "after": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/controllerBootstrap" }] },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "conformance": { "$ref": "#/$defs/bootstrapConformance" }
      }
    },
    "eventV3": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event_type", "repository", "parent_issue", "entity", "source_state_schema", "from_state_digest", "to_state_digest", "authority_ref", "authority_digest", "candidate_binding_digest", "lane_id", "epoch_id", "gate", "lock", "fence_id", "prior_event_id", "receipt_id", "consumed_receipt_ids", "receipt_inventory_digest", "event_id"],
      "properties": {
        "schema": { "const": "toolkit.github-program.managed-event.v3" }, "event_type": { "enum": ["canonical_initialisation", "canonical_transition", "migration", "recovery_transition"] },
        "repository": { "$ref": "#/$defs/safeLine" }, "parent_issue": { "$ref": "#/$defs/issue" },
        "entity": { "type": "object", "additionalProperties": false, "required": ["kind", "number"], "properties": { "kind": { "enum": ["parent", "child", "pr"] }, "number": { "$ref": "#/$defs/issue" } } },
        "source_state_schema": { "oneOf": [{ "type": "null" }, { "enum": ["toolkit.github-program.state.v4", "toolkit.github-program.state.v5", "toolkit.github-program.legacy-state.v1"] }] },
        "from_state_digest": { "$ref": "#/$defs/digest" }, "to_state_digest": { "$ref": "#/$defs/digest" }, "authority_ref": { "$ref": "#/$defs/safeLine" },
        "authority_digest": { "$ref": "#/$defs/nullOrDigest" }, "candidate_binding_digest": { "$ref": "#/$defs/nullOrDigest" },
        "lane_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] }, "epoch_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] }, "gate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] }, "lock": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] }, "fence_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] },
        "prior_event_id": { "$ref": "#/$defs/nullOrDigest" }, "receipt_id": { "$ref": "#/$defs/nullOrDigest" }, "consumed_receipt_ids": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }, "receipt_inventory_digest": { "$ref": "#/$defs/nullOrDigest" }, "event_id": { "$ref": "#/$defs/digest" }
      }
    },
    "eventV2": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event_type", "repository", "parent_issue", "entity", "source_state_schema", "from_state_digest", "to_canonical_digest", "authority_ref", "candidate_binding_digest", "prior_event_id", "migration_binding_digest", "event_id"],
      "properties": {
        "schema": { "const": "toolkit.github-program.managed-event.v2" }, "event_type": { "enum": ["canonical_initialisation", "canonical_transition", "migration"] }, "repository": { "$ref": "#/$defs/safeLine" }, "parent_issue": { "$ref": "#/$defs/issue" },
        "entity": { "type": "object", "additionalProperties": false, "required": ["kind", "number"], "properties": { "kind": { "enum": ["parent", "child", "pr"] }, "number": { "$ref": "#/$defs/issue" } } }, "source_state_schema": { "oneOf": [{ "type": "null" }, { "enum": ["toolkit.github-program.state.v4", "toolkit.github-program.state.v5", "toolkit.github-program.legacy-state.v1"] }] }, "from_state_digest": { "$ref": "#/$defs/digest" }, "to_canonical_digest": { "$ref": "#/$defs/digest" }, "authority_ref": { "$ref": "#/$defs/safeLine" }, "candidate_binding_digest": { "$ref": "#/$defs/nullOrDigest" }, "prior_event_id": { "$ref": "#/$defs/nullOrDigest" }, "migration_binding_digest": { "$ref": "#/$defs/nullOrDigest" }, "event_id": { "$ref": "#/$defs/digest" }
      }
    },
    "eventV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event_type", "repository", "entity", "exact_revision", "resulting_state", "authority_ref", "event_id"],
      "properties": {
        "schema": { "const": "toolkit.github-program.managed-event.v1" }, "event_type": { "enum": ["lifecycle_transition", "lock_accepted", "candidate_bound", "validation", "g4_or_finality", "blocker", "dependency", "owner_decision", "reconciliation_receipt"] }, "repository": { "$ref": "#/$defs/safeLine" }, "entity": { "type": "object", "additionalProperties": false, "required": ["kind", "number"], "properties": { "kind": { "enum": ["parent", "child", "pr"] }, "number": { "$ref": "#/$defs/issue" } } }, "child_issue": { "$ref": "#/$defs/issue" }, "pr_number": { "$ref": "#/$defs/issue" }, "exact_revision": { "$ref": "#/$defs/sha" }, "resulting_state": { "$ref": "#/$defs/safeLine" }, "authority_ref": { "$ref": "#/$defs/safeLine" }, "prior_event": { "$ref": "#/$defs/safeLine" }, "epoch": { "$ref": "#/$defs/safeLine" }, "event_id": { "$ref": "#/$defs/digest" }
      }
    },
    "timestamp": { "type": "string", "minLength": 1, "maxLength": 32, "format": "date-time" },
    "receiptAuthority": {
      "type": "object", "additionalProperties": false, "required": ["child_comment_id", "parent_comment_id", "node_id", "author_login", "author_association", "body_digest", "updated_at", "update_identity_digest", "scope_digest"],
      "properties": { "child_comment_id": { "$ref": "#/$defs/issue" }, "parent_comment_id": { "$ref": "#/$defs/issue" }, "node_id": { "$ref": "#/$defs/safeLine" }, "author_login": { "$ref": "#/$defs/safeLine" }, "author_association": { "const": "OWNER" }, "body_digest": { "$ref": "#/$defs/digest" }, "updated_at": { "$ref": "#/$defs/timestamp" }, "update_identity_digest": { "$ref": "#/$defs/digest" }, "scope_digest": { "$ref": "#/$defs/digest" } }
    },
    "receiptStart": {
      "type": "object", "additionalProperties": false, "required": ["base_sha", "head_sha", "tree_sha", "status_digest", "clean_worktree", "ref"],
      "properties": { "base_sha": { "$ref": "#/$defs/sha" }, "head_sha": { "$ref": "#/$defs/sha" }, "tree_sha": { "$ref": "#/$defs/sha" }, "status_digest": { "$ref": "#/$defs/digest" }, "clean_worktree": { "const": true }, "ref": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["detached", "name"], "properties": { "detached": { "const": true }, "name": { "type": "null" } } }, { "type": "object", "additionalProperties": false, "required": ["detached", "name"], "properties": { "detached": { "const": false }, "name": { "$ref": "#/$defs/safeLine" } } }] } }
    },
    "receiptCandidate": {
      "type": "object", "additionalProperties": false, "required": ["pr_number", "branch", "base_ref", "base_sha", "head_sha", "tree_sha"],
      "properties": { "pr_number": { "$ref": "#/$defs/issue" }, "branch": { "$ref": "#/$defs/safeLine" }, "base_ref": { "$ref": "#/$defs/safeLine" }, "base_sha": { "$ref": "#/$defs/sha" }, "head_sha": { "$ref": "#/$defs/sha" }, "tree_sha": { "$ref": "#/$defs/sha" } }
    },
    "receiptLease": {
      "type": "object", "additionalProperties": false, "required": ["lease_id", "fence_id", "fence_sequence", "issued_at", "expires_at"],
      "properties": { "lease_id": { "$ref": "#/$defs/safeLine" }, "fence_id": { "$ref": "#/$defs/safeLine" }, "fence_sequence": { "type": "integer", "minimum": 1 }, "issued_at": { "$ref": "#/$defs/timestamp" }, "expires_at": { "$ref": "#/$defs/timestamp" } }
    },
    "receiptPayload": {
      "type": "object", "additionalProperties": false, "required": ["classification"],
      "properties": { "classification": { "$ref": "#/$defs/safeId" }, "reason_code": { "$ref": "#/$defs/safeId" }, "outcome_digest": { "$ref": "#/$defs/digest" }, "evidence_digest": { "$ref": "#/$defs/digest" }, "operation_digest": { "$ref": "#/$defs/digest" }, "detail_digest": { "$ref": "#/$defs/digest" }, "mutation_outcome": { "enum": ["KNOWN", "UNKNOWN"] }, "evidence_refs": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": { "id": { "$ref": "#/$defs/safeId" }, "digest": { "$ref": "#/$defs/digest" } } } } }
    },
    "receipt": {
      "type": "object", "additionalProperties": false, "required": ["schema", "receipt_type", "receipt_id", "sequence", "prior_receipt_id", "run_id", "allocation_id", "repository", "parent_issue", "child_issue", "lock", "authority", "start", "candidate", "lease", "payload", "created_at"],
      "properties": { "schema": { "const": "toolkit.github-program.run-receipt.v1" }, "receipt_type": { "enum": ["RUN_STARTED", "TRANSITION_PREVIEW", "EXECUTOR_TERMINAL", "G4_TERMINAL", "RUN_INTERRUPTED"] }, "receipt_id": { "$ref": "#/$defs/digest" }, "sequence": { "type": "integer", "minimum": 1, "maximum": 128 }, "prior_receipt_id": { "$ref": "#/$defs/nullOrDigest" }, "run_id": { "$ref": "#/$defs/safeLine" }, "allocation_id": { "$ref": "#/$defs/safeLine" }, "repository": { "$ref": "#/$defs/safeLine" }, "parent_issue": { "$ref": "#/$defs/issue" }, "child_issue": { "$ref": "#/$defs/issue" }, "lock": { "$ref": "#/$defs/safeId" }, "authority": { "$ref": "#/$defs/receiptAuthority" }, "start": { "$ref": "#/$defs/receiptStart" }, "candidate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/receiptCandidate" }] }, "lease": { "$ref": "#/$defs/receiptLease" }, "payload": { "$ref": "#/$defs/receiptPayload" }, "created_at": { "$ref": "#/$defs/timestamp" } }
    },
    "requiredReceiptDelta": {
      "type": "object", "additionalProperties": false, "required": ["receipt_type", "receipt_id", "started_receipt_id", "started_sequence", "started_classification", "receipt", "chain", "durable_required", "persisted_in_preview", "persist_before_apply", "readback_required", "receipt_inventory_digest", "reason"],
      "properties": { "receipt_type": { "const": "TRANSITION_PREVIEW" }, "receipt_id": { "$ref": "#/$defs/digest" }, "started_receipt_id": { "$ref": "#/$defs/digest" }, "started_sequence": { "const": 1 }, "started_classification": { "const": "RUN_STARTED_VERIFIED" }, "receipt": { "$ref": "#/$defs/receipt" }, "chain": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/receipt" } }, "durable_required": { "const": true }, "persisted_in_preview": { "const": false }, "persist_before_apply": { "const": true }, "readback_required": { "const": true }, "receipt_inventory_digest": { "$ref": "#/$defs/digest" }, "reason": { "$ref": "#/$defs/safeText" } }
    },
    "receiptConsumptionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition", "required_receipt_ids", "receipt_inventory_digest", "persist_before_dependent_progression", "read_back_before_apply", "persisted_in_preview", "on_missing_conflicting_or_stale"],
      "properties": {
        "transition": { "const": "PREVIEW_TO_AUTHORISED_APPLY" },
        "required_receipt_ids": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
        "receipt_inventory_digest": { "$ref": "#/$defs/digest" },
        "persist_before_dependent_progression": { "const": true },
        "read_back_before_apply": { "const": true },
        "persisted_in_preview": { "const": false },
        "on_missing_conflicting_or_stale": { "const": "FAIL_CLOSED" }
      }
    },
    "migrationEventDelta": {
      "type": "object", "additionalProperties": false,
      "required": ["retained_count", "new_events", "retained_history_digest", "target_inventory_digest", "consumed_receipt_ids", "receipt_inventory_digest"],
      "properties": { "retained_count": { "type": "integer", "minimum": 0 }, "new_events": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/eventV3" } }, "retained_history_digest": { "$ref": "#/$defs/digest" }, "target_inventory_digest": { "$ref": "#/$defs/digest" }, "consumed_receipt_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }, "receipt_inventory_digest": { "$ref": "#/$defs/digest" } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "reference", "summary"],
      "properties": { "id": { "$ref": "#/$defs/safeId" }, "kind": { "enum": ["WEB", "COMMIT", "PR", "CHECK", "REVIEW", "ISSUE", "MIGRATION"] }, "reference": { "$ref": "#/$defs/safeLine" }, "summary": { "$ref": "#/$defs/safeLine" } }
    },
    "epoch": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "lock", "purpose", "gates", "terminal_disposition", "evidence_ref"],
      "properties": { "id": { "$ref": "#/$defs/safeId" }, "name": { "$ref": "#/$defs/safeLine" }, "lock": { "$ref": "#/$defs/safeId" }, "purpose": { "$ref": "#/$defs/safeText" }, "gates": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } }, "terminal_disposition": { "enum": [null, "ACCEPTED", "RETIRED"] }, "evidence_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] } }
    },
    "hold": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "summary", "evidence_ref", "active"],
      "properties": { "id": { "$ref": "#/$defs/safeId" }, "kind": { "enum": ["BLOCKING", "INFORMATIONAL"] }, "summary": { "$ref": "#/$defs/safeText" }, "evidence_ref": { "$ref": "#/$defs/safeId" }, "active": { "type": "boolean" } }
    },
    "finality": {
      "type": "object", "additionalProperties": false, "required": ["state", "authority_ref"],
      "properties": { "state": { "enum": ["HELD", "READY_AUTHORIZED", "MERGED", "RETIRED"] }, "authority_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] } }
    },
    "registry": {
      "type": "object", "additionalProperties": false, "required": ["pr", "status", "role", "completes_child", "epoch_id", "accepted_evidence_ref", "retirement_evidence_ref"],
