      "properties": { "repository": { "$ref": "#/$defs/safeLine" }, "revision": { "$ref": "#/$defs/safeLine" }, "complete": { "const": true }, "canonical_state": { "$ref": "#/$defs/canonicalState" }, "bodies": { "type": "object", "additionalProperties": false, "required": ["parent", "children", "prs"], "properties": { "parent": { "type": "string" }, "children": { "type": "object", "additionalProperties": { "type": "string" } }, "prs": { "type": "object", "additionalProperties": { "type": "string" } } } }, "labels": { "$ref": "#/$defs/labels" }, "managed_events": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/eventV1" }, { "$ref": "#/$defs/eventV2" }, { "$ref": "#/$defs/eventV3" }] } }, "native": { "$ref": "#/$defs/nativeSnapshot" }, "bootstrap": { "$ref": "#/$defs/controllerBootstrap" } }
